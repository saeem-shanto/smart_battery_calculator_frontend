# Django backend used by the Next.js server-side proxy.
BACKEND_API_URL=http://127.0.0.1:8000

# Keep account/calculation requests same-origin through Next.js so account JWTs
# can stay in secure HttpOnly cookies. Usually leave NEXT_PUBLIC_BACKEND_API_URL unset.
# NEXT_PUBLIC_BACKEND_API_URL=http://127.0.0.1:8000

# Development/debug overlay. Never expose secrets here; NEXT_PUBLIC_* variables
# are visible to the browser. Set false for the production deployment.
NEXT_PUBLIC_APP_DEBUG=true
APP_DEBUG_BUILD=true
NEXT_PUBLIC_APP_VERSION=1.5.3
