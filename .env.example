# Local development defaults. For deployment, replace both origins with your HTTPS backend URL.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_BACKEND_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_MAX_UPLOAD_MB=15

# Client-side request safety limits in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=30000
NEXT_PUBLIC_UPLOAD_TIMEOUT_MS=60000
NEXT_PUBLIC_CALCULATION_TIMEOUT_MS=120000
